<script lang="ts">
	import { onMount } from 'svelte';

	let content: { title: string; paragraphs: string[] } | null = null;
	let error: string | null = null;
	let loading = true;

	const TIMEOUT_MS = 5000; // 5 seconds

	async function loadContent() {
		loading = true;
		error = null;
		content = null;

		// Start timeout for loading
		const timeoutId = setTimeout(() => {
			if (loading) {
				loading = false;
				error = "Loading timed out. Please try again later.";
			}
		}, TIMEOUT_MS);

		try {
			const res = await fetch('/about.json');
			if (!res.ok) {
				throw new Error(`Could not load content (status ${res.status})`);
			}
			content = await res.json();
			loading = false;
			clearTimeout(timeoutId);
		} catch (err: any) {
			console.error(err);
			loading = false;
			if (!error) {
				error = "Sorry, the About content is currently unavailable.";
			}
			clearTimeout(timeoutId);
		}
	}

	onMount(loadContent);
</script>

<svelte:head>
	<title>About</title>
	<meta name="description" content="About this app" />
</svelte:head>

<div class="text-column">
	{#if loading}
		<p class="p-bubble loading">
			Loading content...
			<span class="loading-bar"></span>
		</p>

	{:else if error}
		<p class="p-bubble">{error}</p>
		<button on:click={loadContent} class="retry-button">Retry</button>

	{:else if content}
		<h1>{content.title}</h1>
		<hr />
		{#each content.paragraphs as paragraph, i}
			<p class="p-bubble" style="animation-delay: {i * 0.2}s">{paragraph}</p>
		{/each}
	{/if}
</div>

<style>
	.text-column {
		display: flex;
		flex-direction: column;
		justify-content: center;
		margin: 0 auto;
		max-width: 48rem;
		padding: 1rem;
	}

	h1 {
		font-size: 2rem;
		text-align: center;
		margin-bottom: 1rem;
	}

	hr {
		margin: 1rem 0;
		border: none;
		height: 1px;
		background-color: rgba(0,0,0,0.15);
	}

	.p-bubble {
		background: rgba(255, 255, 255, 0.35);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		border-radius: 12px;
		padding: 1rem 1.25rem;
		margin: 1rem 0;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12),
		            inset 0 0 0 1px rgba(255, 255, 255, 0.3);
		color: rgba(0, 0, 0, 0.7);
		text-align: left;

		opacity: 0;
		transform: translateY(10px) scale(0.98);
		animation: bubble-pop 0.6s ease-out forwards;
	}

	.p-bubble.loading {
		position: relative;
		overflow: hidden;
	}

	.p-bubble.loading .loading-bar {
		display: block;
		position: absolute;
		bottom: 0;
		left: 0;
		height: 4px;
		width: 0%;
		background-color: var(--color-theme-1, #ff3e00);
		animation: loading-bar 1.5s infinite;
		border-radius: 2px;
	}

	@keyframes loading-bar {
		0% { width: 0%; left: 0%; }
		50% { width: 100%; left: 0%; }
		100% { width: 0%; left: 100%; }
	}

	@keyframes bubble-pop {
		from {
			opacity: 0;
			transform: translateY(10px) scale(0.98);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.retry-button {
		margin-top: 1rem;
		padding: 0.5rem 1rem;
		border-radius: 6px;
		border: none;
		cursor: pointer;
		background-color: var(--color-theme-1, #ff3e00);
		color: white;
		font-weight: bold;
		transition: background-color 0.2s ease;
	}

	.retry-button:hover {
		background-color: #e03500;
	}
</style>
